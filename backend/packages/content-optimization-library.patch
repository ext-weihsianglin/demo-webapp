 # Citation dataset exploration
 
+## Python library
+
+This repository is installable as `content-optimization-exploration` (Python 3.12+).
+Application consumers can install a pinned Git revision with `uv add` and import
+the retention parser:
+
+```python
+from preprocessing.api import parse_snapshot
+
+document, chunks = parse_snapshot(
+    saved_html, "https://example.com/page", "example.com", source_format="html"
+)
+```
+
+This calls the existing source inventory, HTML/native adapters, retention selection,
+document builder and chunker. Omit `source_format` to use the existing format
+classifier. Inputs are saved snapshots; no fetching or inference is performed.
+The return value preserves structured blocks, source metadata, quality flags,
+source identity, heading outlines and chunk IDs. Flags do not discard content.
+Consumers own raw snapshot storage and model token budgeting. The API does not
+invent an evaluation-cache path for submitted content. Existing extraction and
+scoring behavior and frozen artifacts are unchanged.
+
 Preliminary analysis for `project-brief.md`, before choosing a content-generation prototype.
 
 ## Setup
diff --git a/preprocessing/api.py b/preprocessing/api.py
new file mode 100644
index 0000000..48bc92e
--- /dev/null
+++ b/preprocessing/api.py
@@ -0,0 +1,32 @@
+"""Importable retention-first parser for saved snapshots and ephemeral inputs."""
+from preprocessing.adapters.local import extract_conservative, extract_markdown_text
+from preprocessing.downstream import document
+from preprocessing.quality import classify_payload, source_inventory
+from preprocessing.schema import Snapshot, snapshot_identity
+
+PARSER_REVISION = "3d4d35d3c32ac5b8c14983f99f92c2f633669417"
+
+
+def parse_snapshot(payload, href, hostname="", *, source_format=None, source=None):
+    """Return (document, chunks) using the existing inventory/adapters/selection.
+
+    Source format may be supplied by a snapshot manifest or input form; otherwise
+    it is classified using the existing heuristic. No query or label is accepted.
+    The raw payload remains the caller's responsibility; no page is fetched or
+    saved, and no evaluation-cache path is invented for an ephemeral input.
+    """
+    format_name = source_format if source_format is not None else classify_payload(payload)
+    payload_hash, identity = snapshot_identity(payload, href)
+    snapshot = Snapshot(identity, payload_hash, href, hostname, payload, format_name)
+    inventory = source_inventory(payload, href, format_name)
+    candidate = extract_conservative(snapshot) if format_name == "html" else extract_markdown_text(snapshot)
+    provenance = {**(source or {}), "payload_hash": payload_hash, "href": href,
+                  "hostname": hostname, "format": format_name}
+    for key in ("source_file", "source_file_hash", "source_row"):
+        provenance.setdefault(key, None)
+    parsed, chunks = document(snapshot, provenance, [candidate.to_dict()], inventory)
+    parsed["raw_payload_path"] = None
+    parsed["raw_payload_reference"] = {key: provenance[key] for key in
+                                     ("source_file", "source_file_hash", "source_row", "payload_hash")}
+    parsed["candidate_diagnostics"] = candidate.diagnostics
+    return parsed, chunks
