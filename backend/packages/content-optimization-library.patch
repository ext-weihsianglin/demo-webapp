diff --git a/tests/test_library_api.py b/tests/test_library_api.py
new file mode 100644
index 0000000..8a566ea
--- /dev/null
+++ b/tests/test_library_api.py
@@ -0,0 +1,34 @@
+from preprocessing.api import parse_snapshot
+from preprocessing.adapters.local import extract_conservative, extract_markdown_text
+from preprocessing.downstream import document
+from preprocessing.quality import source_inventory
+from preprocessing.schema import Snapshot, snapshot_identity
+
+
+def test_api_matches_original_pipeline_and_does_not_invent_cache_path():
+    payload = '<main><h1>Title</h1><ul><li>Parent<ul><li>Child</li></ul></li></ul><pre>  code\n</pre></main>'
+    href = 'https://example.com/page'
+    parsed, chunks = parse_snapshot(payload, href, 'example.com', source_format='html')
+    payload_hash, identity = snapshot_identity(payload, href)
+    snapshot = Snapshot(identity, payload_hash, href, 'example.com', payload, 'html')
+    source = {'payload_hash': payload_hash, 'href': href, 'hostname': 'example.com', 'format': 'html',
+              'source_file': None, 'source_file_hash': None, 'source_row': None}
+    expected, expected_chunks = document(snapshot, source, [extract_conservative(snapshot).to_dict()], source_inventory(payload, href, 'html'))
+    assert {key: parsed[key] for key in expected if key != 'raw_payload_path'} == {key: expected[key] for key in expected if key != 'raw_payload_path'}
+    assert chunks == expected_chunks
+    assert parsed['raw_payload_path'] is None
+
+
+def test_native_formats_flags_and_insufficient_source():
+    parsed, chunks = parse_snapshot('# Heading\n\n- Parent\n  - Child', 'https://example.com')
+    assert parsed['selection']['method'] == 'markdown_text'
+    assert 'list' in {block['type'] for block in parsed['blocks']}
+    assert [identity for chunk in chunks for identity in chunk['block_ids']] == [block['block_id'] for block in parsed['blocks']]
+    plain, _ = parse_snapshot('# Literal plain text', 'https://example.com', source_format='text')
+    assert plain['blocks'][0]['type'] == 'paragraph'
+    flagged, _ = parse_snapshot('<p>Access denied but keep this caveat.</p>', 'https://example.com')
+    assert flagged['selection']['status'] == 'needs_review'
+    assert flagged['blocks']
+    empty, chunks = parse_snapshot('<html><body><script>run()</script></body></html>', 'https://example.com')
+    assert empty['selection']['status'] == 'source_insufficient'
+    assert empty['blocks'] == chunks == []
