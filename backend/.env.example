CONTENT_EXAMPLES_DIR=data/examples
# Optional; default resolves to backend/data/scoring/model.joblib. Only pinned v2 bytes are accepted.
# P1_MODEL_PATH=data/scoring/model.joblib
# Server only. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-4.1-mini
# Dropdown allowlist; configured default is always included.
OPENAI_REWRITE_MODELS=gpt-4.1-mini,gpt-4.1,gpt-4.1-nano,gpt-5,gpt-5-mini,gpt-5-nano
REWRITE_CONTEXT_TOKENS=128000
REWRITE_OUTPUT_TOKENS=16000
REWRITE_TIMEOUT_SECONDS=120
# Legacy call/retry settings are ignored: one provider attempt per page.
# Default model only: optional configured price estimates (USD per million tokens); no built-in pricing.
REWRITE_INPUT_USD_PER_MILLION=
REWRITE_OUTPUT_USD_PER_MILLION=
