CONTENT_EXAMPLES_DIR=data/examples
# Server only. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-4.1-mini
REWRITE_CONTEXT_TOKENS=16000
REWRITE_OUTPUT_TOKENS=4000
REWRITE_TIMEOUT_SECONDS=45
REWRITE_MAX_RETRIES=1
REWRITE_MAX_CALLS=12
# Optional configured price estimates (USD per million tokens); no built-in pricing.
REWRITE_INPUT_USD_PER_MILLION=
REWRITE_OUTPUT_USD_PER_MILLION=
